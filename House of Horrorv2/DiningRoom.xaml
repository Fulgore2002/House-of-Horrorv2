<UserControl x:Class="House_of_Horrorv2.DiningRoom"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400" Width="600">
    <Grid>
        <TextBlock Name="DiningRoomText" Text="You chose to go into the dining room. As you walk in, you see a shiny vase on the table." TextWrapping="Wrap" Margin="10" Background="#FFA6AFA6"/>
        <StackPanel VerticalAlignment="Bottom" Margin="10">
            <Button Name="VaseChoiceButton" Content="Open the Vase" Click="VaseChoiceButton_Click"/>
            <Button Name="RunButton" Content="Run" Click="RunButton_Click" Visibility="Collapsed"/>
            <Button Name="FightButton" Content="Fight" Click="FightButton_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
