<UserControl x:Class="House_of_Horrorv2.MasterBedroom"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400" Width="600">
    <Grid>
        <TextBlock Name="MasterBedroomText" Text="You chose to go into the master bedroom. As you walk in, you see an ornate bed and a large, dusty wardrobe." TextWrapping="Wrap" Margin="10" Background="#FFE8B2B2"/>
        <StackPanel VerticalAlignment="Bottom" Margin="10">
            <Button Name="WardrobeChoiceButton" Content="Open the Wardrobe" Click="WardrobeChoiceButton_Click"/>
            <Button Name="ItemChoiceButton" Content="Take the Locket and Holy Relic" Click="ItemChoiceButton_Click" Visibility="Collapsed"/>
            <Button Name="LeaveButton" Content="Leave" Click="LeaveButton_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
