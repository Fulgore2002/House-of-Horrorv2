<UserControl x:Class="House_of_Horrorv2.Kitchen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400" Width="600">
    <Grid>
        <TextBlock Name="KitchenText" Text="You chose to go into the kitchen. As you walk in, you see a refrigerator humming loudly." TextWrapping="Wrap" Margin="10" Background="#FF88DDF0"/>
        <StackPanel VerticalAlignment="Bottom" Margin="10">
            <Button Name="FridgeChoiceButton" Content="Open the Refrigerator" Click="FridgeChoiceButton_Click"/>
            <Button Name="PantryChoiceButton" Content="Investigate the Pantry Noise" Click="PantryChoiceButton_Click" Visibility="Collapsed"/>
            <Button Name="WhisperChoiceButton" Content="Investigate the Noise Behind the Refrigerator" Click="WhisperChoiceButton_Click" Visibility="Collapsed"/>
            <Button Name="YesButton" Content="Yes" Click="YesButton_Click" Visibility="Collapsed"/>
            <Button Name="NoButton" Content="No" Click="NoButton_Click" Visibility="Collapsed"/>
            <Button Name="YesWhisperButton" Content="Yes" Click="YesWhisperButton_Click" Visibility="Collapsed"/>
            <Button Name="NoWhisperButton" Content="No" Click="NoWhisperButton_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
