<UserControl x:Class="House_of_Horrorv2.Backyard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400" Width="600">
    <Grid>
        <TextBlock Name="BackyardText" Text="You chose to go into the backyard. As you walk outside, you see an old shed with a rusty lock." TextWrapping="Wrap" Margin="10"/>
        <StackPanel VerticalAlignment="Bottom" Margin="10">
            <Button Name="KeyCheckButton" Content="Check for Rusty Key" Click="KeyCheckButton_Click"/>
            <Button Name="ShedChoiceButton" Content="Try the Rusty Key on the Lock" Click="ShedChoiceButton_Click" Visibility="Collapsed"/>
            <Button Name="LeaveButton" Content="Leave" Click="LeaveButton_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
