<Window x:Class="House_of_Horrorv2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:House_of_Horrorv2"
        Title="Haunted Mansion Game" Height="450" Width="800">
    <Grid>
        <Button Content="Living Room" HorizontalAlignment="Left" VerticalAlignment="Top" Click="LivingRoom_Click"/>
        <Button Content="Dining Room" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,40,0,0" Click="DiningRoom_Click"/>
        <Button Content="Kitchen" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,80,0,0" Click="Kitchen_Click"/>
        <Button Content="Backyard" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,120,0,0" Click="Backyard_Click"/>
        <Button Content="Master Bedroom" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,160,0,0" Click="MasterBedroom_Click"/>

        <ContentControl Name="ContentArea" HorizontalAlignment="Right" VerticalAlignment="Top" Width="600" Height="400"/>
    </Grid>
</Window>
